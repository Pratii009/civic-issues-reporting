<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Slogan Section -->
        <TextView
            android:id="@+id/sloganTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raise Your Voice for a Better City!"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/sloganSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your small report can bring a big change."
            android:textSize="15sp"
            android:textColor="#4A4A4A"
            android:paddingBottom="20dp" />

        <!-- Report New Issue Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardReportNewIssue"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="18dp"
            card_view:cardCornerRadius="14dp"
            card_view:cardElevation="8dp"
            android:foreground="?attr/selectableItemBackground"
            card_view:cardBackgroundColor="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_report"
                    card_view:tint="#1A73E8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report New Issue"
                    android:textColor="#1A73E8"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Municipal Contact Details Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardMunicipal"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="18dp"
            card_view:cardCornerRadius="14dp"
            card_view:cardElevation="8dp"
            card_view:cardBackgroundColor="#FFF8E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_phone"
                    card_view:tint="#FF9800" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Municipal Contact Info"
                    android:textColor="#EF6C00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Emergency Helpline Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardEmergency"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="20dp"
            card_view:cardCornerRadius="14dp"
            card_view:cardElevation="8dp"
            card_view:cardBackgroundColor="#FFEBEE">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_emergency"
                    card_view:tint="#D32F2F" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Helplines"
                    android:textColor="#C62828"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
